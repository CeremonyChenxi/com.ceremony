<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.EmployeeMapper">
    <insert id="insertEmployee" parameterType="employee">
    insert into employee
        (name,username,password,phone,sex,id_number,
         status,create_time,update_time,create_user,
         update_user)
        values ( #{name},#{username},#{password},
                #{phone},#{sex},#{idNumber},#{status},#{createTime},#{updateTime},
                #{createUser},#{updateUser});
    </insert>
    <select id="getListEmployeeByPage" resultType="Employee">
        select * from Employee
            <where>
                <if test="name!=null"> name like concat('%',#{name},'%')</if>
            </where>
    </select>
    <update id="banEmployee" >
            update Employee set status=#{status} where id=#{id}
    </update>

    <select id="getEmployeeByID" resultType="com.sky.dto.EmployeeDTO">
        select * from Employee where id=#{id}
    </select>

    <update id="editEmployee" >
        update Employee set username=#{username},name=#{name},phone=#{phone},sex=#{sex},id_number=#{idNumber}
            where id=#{id}
    </update>

    <select id="getPasswordById" resultType="java.lang.String">
        select password from Employee where id =#{id}
    </select>
    <update id="editPassword">

    update Employee set password =md5(#{newPassword}) where id=#{id}
    </update>
</mapper>
